# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
~$*
/recovery/
/tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Private Evernote exports must never be published with application code.
*.enex

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Original local clips; publish the optimized, silent MP4 files instead.
/public/Kerst/Kerststol IMG_3403_VSCO.MOV
/public/Kerst/Tulband Video.MP4
/public/Kerst/Bonbon IMG_5450.MOV

# Local previews, screenshots and QA exports (existing tracked documents remain tracked).
/output/
